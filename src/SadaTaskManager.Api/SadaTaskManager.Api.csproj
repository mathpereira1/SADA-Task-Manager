	<ItemGroup>
		<ProjectReference Include="..\SadaTaskManager.Application\SadaTaskManager.Application.csproj" />
		<ProjectReference Include="..\SadaTaskManager.Infrastructure\SadaTaskManager.Infrastructure.csproj" />
	</ItemGroup>

</Project>
